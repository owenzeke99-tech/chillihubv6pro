-- [[ Chilli Hub V6 Pro - Expanded Key System ]]
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Player = Players.LocalPlayer

-- Hidden key persistence check (24 hours background storage)
local KEY_FILE = "ChilliHubV6_KeyData.json"
local function isKeyValid()
	if readfile and isfile and isfile(KEY_FILE) then
		local success, data = pcall(function()
			return game:GetService("HttpService"):JSONDecode(readfile(KEY_FILE))
		end)
		if success and data and data.Expiry and os.time() < data.Expiry then
			return true
		end
	end
	return false
end

local function saveKey()
	if writefile then
		local data = { Expiry = os.time() + 86400 } -- Saves key valid for 24 hours silently
		pcall(function()
			writefile(KEY_FILE, game:GetService("HttpService"):JSONEncode(data))
		end)
	end
end

-- Load main execution script
local function loadMainScript()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/kadit9999/stealanegg/refs/heads/main/ChilliV5BaKhi.lua"))()
	end)
	if not success then
		warn("Failed to load main script: " .. tostring(err))
	end
end

if isKeyValid() then
	loadMainScript()
	return
end

-- Clear existing UI if re-executed
if CoreGui:FindFirstChild("ChilliHubV6KeySystem") then
	CoreGui.ChilliHubV6KeySystem:Destroy()
end

