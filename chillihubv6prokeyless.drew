	TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}):Play()
end)
GetKeyBtn.MouseLeave:Connect(function()
	TweenService:Create(GetKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 38)}):Play()
end)

CheckKeyBtn.MouseEnter:Connect(function()
	TweenService:Create(CheckKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 60)}):Play()
end)
CheckKeyBtn.MouseLeave:Connect(function()
	TweenService:Create(CheckKeyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(220, 25, 45)}):Play()
end)

-- Smooth Shake Animation on Invalid Key
local function smoothShake()
	local basePos = UDim2.new(0.5, -210, 0.5, -135)
	local shakeOffsets = {14, -12, 10, -8, 5, -3, 0}
	
	task.spawn(function()
		for _, offset in ipairs(shakeOffsets) do
			local targetPos = UDim2.new(basePos.X.Scale, basePos.X.Offset + offset, basePos.Y.Scale, basePos.Y.Offset)
			local tween = TweenService:Create(MainFrame, TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = targetPos})
			tween:Play()
			tween.Completed:Wait()
		end
		MainFrame.Position = basePos
	end)
end

-- Input Error Glow Flash
local function flashError()
	TweenService:Create(InputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 40, 60)}):Play()
	task.delay(0.8, function()
		TweenService:Create(InputStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(45, 45, 55)}):Play()
	end)
end

-- Get Key Action (Copies custom link4m URL)
GetKeyBtn.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard("https://link4m.org/YEXQkw")
		StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
		StatusLabel.Text = "Key link copied to clipboard!"
	else
		StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
		StatusLabel.Text = "Clipboard function not supported."
	end
end)

-- Check Key Action
CheckKeyBtn.MouseButton1Click:Connect(function()
	local enteredKey = TextBox.Text
	local correctKey = "ChilliHubV6ProJskwowiLapwowhebiBakaowowjwkPqpwiow"

	if enteredKey == correctKey then
		StatusLabel.TextColor3 = Color3.fromRGB(60, 255, 120)
		StatusLabel.Text = "Access Granted! Loading..."
		saveKey() -- Saves status quietly for 24h
		
		TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -210, 0.5, -160), BackgroundTransparency = 1}):Play()
		TweenService:Create(UIStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
		
		task.wait(0.5)
		ScreenGui:Destroy()
		loadMainScript()
	else
		StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
		StatusLabel.Text = "Invalid Key! Please try again."
		
		smoothShake()
		flashError()
		
		-- Auto-clear input text on error
		TextBox.Text = ""
	end
end)
